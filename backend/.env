# =====================================
# Local Development Configuration
# =====================================
PORT=5000
JWT_SECRET=your_local_dev_secret_key_12345
DATABASE_PATH=./db/notes.db
NODE_ENV=development

# =====================================
# Production Configuration (Vercel)
# =====================================
# For production, set these in Vercel dashboard:
#
# JWT_SECRET=your_strong_production_secret_key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/dbname (from Supabase or Railway)
# FRONTEND_URL=https://your-domain.vercel.app (for CORS)
#
# Example Supabase connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@xxxx.postgres.supabase.co:5432/postgres
