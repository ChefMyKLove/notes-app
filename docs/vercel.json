{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "docs",
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/vosk-proxy.js": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}